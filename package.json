{
  "name": "bounded-clinical-adaptation",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Open-source Chinese outpatient record demo created as a competition case using synthetic data.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
